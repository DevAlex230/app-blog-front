# Railway дає порт через $PORT, локально слухаємо 8080.
:{$PORT:8080} {
	encode gzip zstd

	# API живе на тому ж домені під /api, тому CORS не потрібен взагалі:
	# /api/posts?limit=10 можна відкрити просто в адресному рядку.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy {$API_UPSTREAM:https://nest-api-production-5b2a.up.railway.app} {
			# Railway маршрутизує за Host, тому підставляємо хост апстріма.
			header_up Host {upstream_hostport}
		}
	}

	# Решта — статика Angular.
	handle {
		root * /srv

		@immutable path *.js *.css *.woff2 *.ico *.png *.svg
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		# SPA: усі маршрути віддаємо index.html, роутинг робить Angular.
		try_files {path} /index.html
		file_server
	}
}
